parameters:
	ignoreErrors:
		-
			message: '''
				#^Call to deprecated method setError\(\) of class Joomla\\CMS\\MVC\\Model\\BaseModel\:
				3\.1\.4 will be removed in 7\.0
				             Will be removed without replacement
				             Throw an Exception instead of using setError$#
			'''
			identifier: method.deprecated
			count: 1
			path: src/administrator/components/com_jed/src/Model/TicketinternalnoteModel.php

		-
			message: '''
				#^Call to method getDispatcher\(\) of deprecated interface Joomla\\CMS\\Application\\EventAwareInterface\:
				4\.3 will be removed in 7\.0
				             This interface will be removed without replacement as the Joomla 3\.x compatibility layer will be removed$#
			'''
			identifier: method.deprecatedInterface
			count: 1
			path: src/administrator/components/com_jed/src/Service/ScoreCalculationService.php

		-
			message: '#^Instantiated class Webklex\\PHPIMAP\\ClientManager not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/administrator/components/com_vel/src/Mail/ImapFetcher.php

		-
			message: '''
				#^Call to deprecated method setError\(\) of class Joomla\\CMS\\MVC\\Model\\BaseModel\:
				3\.1\.4 will be removed in 7\.0
				             Will be removed without replacement
				             Throw an Exception instead of using setError$#
			'''
			identifier: method.deprecated
			count: 3
			path: src/administrator/components/com_vel/src/Model/AdvisoryModel.php

		-
			message: '''
				#^Call to method getDispatcher\(\) of deprecated interface Joomla\\CMS\\Application\\EventAwareInterface\:
				4\.3 will be removed in 7\.0
				             This interface will be removed without replacement as the Joomla 3\.x compatibility layer will be removed$#
			'''
			identifier: method.deprecatedInterface
			count: 1
			path: src/administrator/components/com_vel/src/Service/VelService.php

		-
			message: '''
				#^Call to deprecated method setError\(\) of class Joomla\\CMS\\Table\\Table\:
				3\.1\.4 will be removed in 7\.0
				             Will be removed without replacement
				             Throw an Exception instead of using setError$#
			'''
			identifier: method.deprecated
			count: 2
			path: src/administrator/components/com_vel/src/Table/AdvisoryTable.php

		-
			message: '#^Class Jed\\Component\\Jed\\Site\\Field\\ForeignKeyField has an uninitialized readonly property \$limit\. Assign it in the constructor\.$#'
			identifier: property.uninitializedReadonly
			count: 1
			path: src/components/com_jed/src/Field/ForeignkeyField.php

		-
			message: '''
				#^Call to deprecated method getInstance\(\) of class Joomla\\CMS\\Categories\\Categories\:
				4\.0 will be removed in 7\.0
				             Use the ComponentInterface to get the categories
				             Example\: Factory\:\:getApplication\(\)\-\>bootComponent\(\$component\)\-\>getCategory\(\$options, \$section\);$#
			'''
			identifier: staticMethod.deprecated
			count: 1
			path: src/components/com_jed/src/Model/CategoriesModel.php

		-
			message: '#^Parameter \$event of method Joomla\\Plugin\\Privacy\\Vel\\Extension\\Vel\:\:onPrivacyCollectAdminCapabilities\(\) has invalid type Joomla\\Component\\Privacy\\Administrator\\Event\\CollectCapabilitiesEvent\.$#'
			identifier: class.notFound
			count: 1
			path: src/plugins/privacy/vel/src/Extension/Vel.php

		-
			message: '#^Parameter \$event of method Joomla\\Plugin\\Privacy\\Vel\\Extension\\Vel\:\:onPrivacyExportRequest\(\) has invalid type Joomla\\Component\\Privacy\\Administrator\\Event\\ExportRequestEvent\.$#'
			identifier: class.notFound
			count: 1
			path: src/plugins/privacy/vel/src/Extension/Vel.php

		-
			message: '#^Parameter \$event of method Joomla\\Plugin\\Privacy\\Vel\\Extension\\Vel\:\:onPrivacyRemoveData\(\) has invalid type Joomla\\Component\\Privacy\\Administrator\\Event\\RemoveDataEvent\.$#'
			identifier: class.notFound
			count: 1
			path: src/plugins/privacy/vel/src/Extension/Vel.php

		-
			message: '''
				#^Call to deprecated method getDbo\(\) of class Joomla\\CMS\\Factory\:
				4\.3 will be removed in 7\.0
				             Use the database service in the DI container
				             Example\:
				             Factory\:\:getContainer\(\)\-\>get\(DatabaseInterface\:\:class\);$#
			'''
			identifier: staticMethod.deprecated
			count: 1
			path: src/plugins/sampledata/jed/jed.php

		-
			message: '''
				#^Call to deprecated method getDispatcher\(\) of class Joomla\\CMS\\Plugin\\CMSPlugin\:
				5\.2 will be removed in 7\.0
				             Plugin should implement DispatcherAwareInterface on its own, when it is needed\.$#
			'''
			identifier: method.deprecated
			count: 1
			path: src/plugins/sampledata/jed/jed.php
