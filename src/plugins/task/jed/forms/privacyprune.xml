<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="params">
		<fieldset name="task_params">
			<!--
				The defaults are the ones argued in PrivacyRetentionService. They are exposed here
				because 8.17 leaves the periods open: a legal review can change a number without a
				release. Zero means "keep", not "delete everything" - an empty field arrives as 0
				and must not be the input that empties a table.
			-->
			<field
				name="review_ip_days"
				type="number"
				label="PLG_TASK_JED_PRIVACYPRUNE_REVIEW_IP_DAYS"
				description="PLG_TASK_JED_PRIVACYPRUNE_REVIEW_IP_DAYS_DESC"
				default="180"
				min="0"
				step="1"
				filter="int"
			/>
			<field
				name="transfer_lookup_days"
				type="number"
				label="PLG_TASK_JED_PRIVACYPRUNE_LOOKUP_DAYS"
				description="PLG_TASK_JED_PRIVACYPRUNE_LOOKUP_DAYS_DESC"
				default="90"
				min="0"
				step="1"
				filter="int"
			/>
			<field
				name="url_check_days"
				type="number"
				label="PLG_TASK_JED_PRIVACYPRUNE_URL_CHECK_DAYS"
				description="PLG_TASK_JED_PRIVACYPRUNE_URL_CHECK_DAYS_DESC"
				default="365"
				min="0"
				step="1"
				filter="int"
			/>
		</fieldset>
	</fields>
</form>
