<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="params">
		<fieldset name="task_params">
			<!--
				Batch size and cadence together decide two things at once: how quickly the stock
				rotates, and how much traffic the JED sends to the sites it checks. 200 every 30
				minutes rotates the ~29,000 live URLs in about three days, which is the interval
				the state table is written against. Raising one without thinking about the other
				turns the directory into a nuisance for the developers it exists to serve.
			-->
			<field
				name="batch_size"
				type="number"
				label="PLG_TASK_JED_LABEL_BATCH_SIZE"
				description="PLG_TASK_JED_LINKCHECK_BATCH_SIZE_DESC"
				default="200"
				min="1"
				step="1"
				filter="int"
			/>
			<field
				name="force"
				type="radio"
				label="PLG_TASK_JED_LABEL_FORCE"
				description="PLG_TASK_JED_LINKCHECK_FORCE_DESC"
				layout="joomla.form.field.radio.switcher"
				default="0"
			>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</form>
