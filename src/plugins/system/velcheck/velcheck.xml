<?xml version="1.0" encoding="UTF-8"?>
<!--
    The reference consumer of the VEL check API (VEL2-PRD J-05). Installed on any Joomla site,
    not part of pkg_jed: it talks to extensions.joomla.org the way a third-party checker would,
    and is the acceptance test of the API contract.
-->
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_velcheck</name>
	<author>Joomla! Project</author>
	<creationDate>##DATE##</creationDate>
	<copyright>(C) ##YEAR## Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>##VERSION##</version>
	<description>PLG_SYSTEM_VELCHECK_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\System\Velcheck</namespace>
	<files>
		##FILES##
	</files>
	<languages>
		##LANGUAGE_FILES##
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="api_base"
					type="url"
					label="PLG_SYSTEM_VELCHECK_FIELD_API_BASE_LABEL"
					description="PLG_SYSTEM_VELCHECK_FIELD_API_BASE_DESC"
					default="https://extensions.joomla.org/vulnerable-extensions/api/v2"
					filter="url"
				/>
				<field
					name="mode"
					type="list"
					label="PLG_SYSTEM_VELCHECK_FIELD_MODE_LABEL"
					description="PLG_SYSTEM_VELCHECK_FIELD_MODE_DESC"
					default="dataset"
				>
					<option value="dataset">PLG_SYSTEM_VELCHECK_FIELD_MODE_DATASET</option>
					<option value="check">PLG_SYSTEM_VELCHECK_FIELD_MODE_CHECK</option>
				</field>
				<field
					name="cache_hours"
					type="number"
					label="PLG_SYSTEM_VELCHECK_FIELD_CACHE_HOURS_LABEL"
					description="PLG_SYSTEM_VELCHECK_FIELD_CACHE_HOURS_DESC"
					default="12"
					min="1"
					max="168"
					filter="integer"
				/>
				<field
					name="include_patched"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_VELCHECK_FIELD_INCLUDE_PATCHED_LABEL"
					description="PLG_SYSTEM_VELCHECK_FIELD_INCLUDE_PATCHED_DESC"
					default="1"
					filter="integer"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
