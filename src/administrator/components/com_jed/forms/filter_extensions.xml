<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" description="JSEARCH_FILTER"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string"/>

        <field name="state"
               type="status"
               label="COM_JED_FILTER_STATE"
               description="COM_JED_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <!--
            The clean-up list P1-11 owes the JED team. A one-off report would be out of date the
            first time somebody fixed a row; this stays true, and it is where the migration's
            "%d could not be recognised" message points.
        -->
        <field name="video"
               type="list"
               label="COM_JED_EXTENSION_FILTER_VIDEO"
               onchange="this.form.submit();"
        >
            <option value="">COM_JED_EXTENSION_FILTER_VIDEO_SELECT</option>
            <option value="unrecognised">COM_JED_EXTENSION_FILTER_VIDEO_UNRECOGNISED</option>
            <option value="recognised">COM_JED_EXTENSION_FILTER_VIDEO_RECOGNISED</option>
            <option value="none">COM_JED_EXTENSION_FILTER_VIDEO_NONE</option>
        </field>

        <!--
            Link health during moderation (P1-09 item 8). "Left unattended" is the one that
            matters: it is the set where the developer was told and nothing happened, which is
            what the abandonware case in P1-19 will be built from.
        -->
        <field name="links"
               type="list"
               label="COM_JED_EXTENSION_FILTER_LINKS"
               onchange="this.form.submit();"
        >
            <option value="">COM_JED_EXTENSION_FILTER_LINKS_SELECT</option>
            <option value="broken">COM_JED_EXTENSION_FILTER_LINKS_BROKEN</option>
            <option value="escalated">COM_JED_EXTENSION_FILTER_LINKS_ESCALATED</option>
            <option value="ticket">COM_JED_EXTENSION_FILTER_LINKS_TICKET</option>
            <option value="ok">COM_JED_EXTENSION_FILTER_LINKS_OK</option>
        </field>

    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_JED_LIST_FULL_ORDERING"
               description="COM_JED_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.id ASC">COM_JED_GENERAL_FILTER_SORT_ID_ASC</option>
            <option value="a.id DESC">COM_JED_GENERAL_FILTER_SORT_ID_DESC</option>
            <option value="a.name ASC">COM_JED_TITLE_ASC</option>
            <option value="a.name DESC">COM_JED_TITLE_DESC</option>
            <option value="a.alias ASC">COM_JED_GENERAL_FILTER_SORT_ALIAS_ASC</option>
            <option value="a.alias DESC">COM_JED_GENERAL_FILTER_SORT_ALIAS_DESC</option>
            <option value="a.state ASC">COM_JED_GENERAL_FILTER_SORT_PUBLISHED_ASC</option>
            <option value="a.state DESC">COM_JED_GENERAL_FILTER_SORT_PUBLISHED_DESC</option>
            <option value="a.joomla_versions ASC">COM_JED_EXTENSION_FILTER_SORT_JOOMLA_VERSIONS_ASC</option>
            <option value="a.joomla_versions DESC">COM_JED_EXTENSION_FILTER_SORT_JOOMLA_VERSIONS_DESC</option>
            <option value="a.popular ASC">COM_JED_EXTENSION_FILTER_SORT_POPULAR_ASC</option>
            <option value="a.popular DESC">COM_JED_EXTENSION_FILTER_SORT_POPULAR_DESC</option>
            <option value="a.requires_registration ASC">COM_JED_EXTENSION_FILTER_SORT_REQUIRES_REGISTRATION_ASC</option>
            <option value="a.requires_registration DESC">COM_JED_EXTENSION_FILTER_SORT_REQUIRES_REGISTRATION_DESC</option>
            <option value="a.type ASC">COM_JED_EXTENSION_FILTER_SORT_TYPE_ASC</option>
            <option value="a.type DESC">COM_JED_EXTENSION_FILTER_SORT_TYPE_DESC</option>
            <option value="a.extension_types ASC">COM_JED_EXTENSION_FILTER_SORT_INCLUDES_ASC</option>
            <option value="a.extension_types DESC">COM_JED_EXTENSION_FILTER_SORT_INCLUDES_DESC</option>
            <option value="a.approved ASC">COM_JED_EXTENSION_FILTER_SORT_APPROVED_ASC</option>
            <option value="a.approved DESC">COM_JED_EXTENSION_FILTER_SORT_APPROVED_DESC</option>
            <option value="a.approved_time ASC">COM_JED_EXTENSION_FILTER_SORT_APPROVED_TIME_ASC</option>
            <option value="a.approved_time DESC">COM_JED_EXTENSION_FILTER_SORT_APPROVED_TIME_DESC</option>
            <option value="a.catid ASC">COM_JED_EXTENSION_FILTER_SORT_PRIMARY_CATEGORY_ID_ASC</option>
            <option value="a.catid DESC">COM_JED_EXTENSION_FILTER_SORT_PRIMARY_CATEGORY_ID_DESC</option>

        </field>

        <field name="limit"
               type="limitbox"
               label="COM_JED_LIST_LIMIT"
               description="COM_JED_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>