<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <!-- The label used to be COM_USERS_FILTER_SEARCH_DESC, a com_users key that is not loaded here. -->
        <field name="search" type="text"
               label="JSEARCH_FILTER"
               hint="JSEARCH_FILTER"
               description="COM_TICKETS_TICKETS_FILTER_SEARCH_DESC"
               class="js-stools-search-string"/>

        <!--
            The status filter runs against `ticket_status`, the same column the Status column in
            the list renders, so the words in the filter and the words in the table are the one
            vocabulary (New / Awaiting User / Awaiting JED / Resolved / Closed / Updated).

            An unselected filter hides Resolved tickets - see TicketsModel::getListQuery(). "All"
            is the way to ask for them alongside everything else.
        -->
        <field name="ticket_status" type="list" label="JSTATUS"
               description="COM_TICKETS_TICKETS_FILTER_STATUS_DESC" class="inputbox" size="1"
               onchange="this.form.submit();">
            <option value="">COM_TICKETS_TICKETS_SELECT_STATUS_LABEL</option>
            <option value="*">JALL</option>
            <option value="0">COM_TICKETS_TICKETS_TICKET_STATUS_OPTION_0</option>
            <option value="1">COM_TICKETS_TICKETS_TICKET_STATUS_OPTION_1</option>
            <option value="2">COM_TICKETS_TICKETS_TICKET_STATUS_OPTION_2</option>
            <option value="3">COM_TICKETS_TICKETS_TICKET_STATUS_OPTION_3</option>
            <option value="4">COM_TICKETS_TICKETS_TICKET_STATUS_OPTION_4</option>
            <option value="5">COM_TICKETS_TICKETS_TICKET_STATUS_OPTION_5</option>
        </field>

        <field name="ticket_category_type" type="sql" label="COM_TICKETS_GENERAL_TYPE_LABEL"
               query="SELECT `id` AS `id`, `categorytype` AS val FROM `#__jed_ticket_categories` ORDER BY `categorytype` ASC"
               header="COM_TICKETS_GENERAL_SELECT_TYPE_LABEL" key_field="id" value_field="val"
               class="inputbox"
               onchange="this.form.submit();" translate="true"/>
    </fields>

    <fields name="list">
        <!--
            The option values have to be spelled exactly as they appear in TicketsModel's
            filter_fields, backticks included - ListModel::populateState() validates the submitted
            ordering with in_array() and silently falls back to the default when it does not match.
        -->
        <field name="fullordering"
               type="list"
               label="COM_TICKETS_GENERAL_FILTER_FULL_ORDERING_LABEL"
               description="COM_TICKETS_GENERAL_FILTER_FULL_ORDERING_LABEL_DESC"
               onchange="this.form.submit();"
               default="a.`created_on` DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.`created_on` DESC">COM_TICKETS_GENERAL_FILTER_SORT_CREATED_ON_DESC</option>
            <option value="a.`created_on` ASC">COM_TICKETS_GENERAL_FILTER_SORT_CREATED_ON_ASC</option>
            <option value="a.`id` ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.`id` DESC">JGRID_HEADING_ID_DESC</option>
            <option value="a.`ticket_category_type` ASC">COM_TICKETS_TICKETS_FILTER_SORT_TICKET_CATEGORY_TYPE_ASC</option>
            <option value="a.`ticket_category_type` DESC">COM_TICKETS_TICKETS_FILTER_SORT_TICKET_CATEGORY_TYPE_DESC</option>
            <option value="a.`ticket_subject` ASC">COM_TICKETS_TICKETS_FILTER_SORT_TICKET_SUBJECT_ASC</option>
            <option value="a.`ticket_subject` DESC">COM_TICKETS_TICKETS_FILTER_SORT_TICKET_SUBJECT_DESC</option>
            <option value="a.`linked_item_type` ASC">COM_TICKETS_TICKETS_FILTER_SORT_LINKED_ITEM_TYPE_ASC</option>
            <option value="a.`linked_item_type` DESC">COM_TICKETS_TICKETS_FILTER_SORT_LINKED_ITEM_TYPE_DESC</option>
            <option value="a.`ticket_status` ASC">COM_TICKETS_TICKETS_FILTER_SORT_TICKET_STATUS_ASC</option>
            <option value="a.`ticket_status` DESC">COM_TICKETS_TICKETS_FILTER_SORT_TICKET_STATUS_DESC</option>
            <option value="a.`allocated_group` ASC">COM_TICKETS_TICKETS_FILTER_SORT_ALLOCATED_GROUP_ASC</option>
            <option value="a.`allocated_group` DESC">COM_TICKETS_TICKETS_FILTER_SORT_ALLOCATED_GROUP_DESC</option>
        </field>

        <field name="limit"
               type="limitbox"
               label="COM_TICKETS_GENERAL_FILTER_LIMIT_LABEL"
               description="COM_TICKETS_GENERAL_FILTER_LIMIT_LABEL_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>
</form>
